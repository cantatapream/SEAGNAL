<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name=".SeagnalApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- [헤드업 알림] 채널 지정이 없는 푸시(서버의 일반 푸시 전부)가 쓸 기본 알림 채널.
             값은 SeagnalApplication.PUSH_CHANNEL_ID 와 같아야 한다(중요도 높음 → 화면 위에 잠깐 뜬다).
             채널은 SeagnalApplication.onCreate 가 만든다. 채널이 없으면 Firebase 가 종전 채널로 돌아간다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="seagnal_push_high" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- ════════════════════════════════════════════════════════════════
             위치기반 해상특보(killed 대응) FCM 수신 서비스.

             @capacitor/push-notifications 의 라이브러리 서비스
             (com.capacitorjs.plugins.pushnotifications.MessagingService)를 상속한다.
             FirebaseMessagingService 는 앱당 하나만 메시지를 받으므로:
               1) 라이브러리 서비스를 tools:node="remove" 로 제거하고
               2) 그 서브클래스인 우리 서비스를 MESSAGING_EVENT 로 등록한다.
             우리 서비스는 onMessageReceived 에서 super(=Capacitor 처리)를 항상 호출하므로
             기존 푸시 기능(포그라운드 리스너/일반 알림/토큰 등록)은 그대로 보존된다.
             ════════════════════════════════════════════════════════════════ -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".locationalert.LocationAlertMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 위치기반 특보 경보(②): 앱 종료 상태에서도 위치 확인 — 백그라운드 위치 + 전경 서비스(위치) -->
    <!-- [확인필요-빌드후] 전경 서비스 <service android:foregroundServiceType="location"> 선언은
         @capacitor-community/background-geolocation 플러그인 매니페스트가 머지하여 제공한다.
         npx cap sync 후 app/build/intermediates/.../AndroidManifest.xml(merged)에서
         BackgroundGeolocationService + foregroundServiceType="location" 존재를 확인할 것.
         (여기서 동일 service명을 직접 선언하면 머지 충돌로 빌드 실패 위험 → 머지 결과 부재 시에만 수동 추가) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- [음성 비서 삭제 2026-11-19, 사용자 지시] 마이크(RECORD_AUDIO)·마이크 전경 서비스(FOREGROUND_SERVICE_MICROPHONE)·
         음성 모델 내려받기 전경 서비스(FOREGROUND_SERVICE_DATA_SYNC) 권한과 그 서비스 2개를 지웠다.
         FOREGROUND_SERVICE 는 백그라운드 위치 플러그인(@capacitor-community/background-geolocation)이 자기 매니페스트로
         선언하므로 병합 결과에는 그대로 남는다 — 여기서는 종전 선언을 유지한다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 네트워크 상태 확인 — MainActivity 의 오프라인 판정(ConnectivityManager)이 쓴다 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
