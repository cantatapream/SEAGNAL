<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name=".SeagnalApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- [헤드업 알림] 채널 지정이 없는 푸시(서버의 일반 푸시 전부)가 쓸 기본 알림 채널.
             값은 SeagnalApplication.PUSH_CHANNEL_ID 와 같아야 한다(중요도 높음 → 화면 위에 잠깐 뜬다).
             채널은 SeagnalApplication.onCreate 가 만든다. 채널이 없으면 Firebase 가 종전 채널로 돌아간다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="seagnal_push_high" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- ════════════════════════════════════════════════════════════════
             위치기반 해상특보(killed 대응) FCM 수신 서비스.

             @capacitor/push-notifications 의 라이브러리 서비스
             (com.capacitorjs.plugins.pushnotifications.MessagingService)를 상속한다.
             FirebaseMessagingService 는 앱당 하나만 메시지를 받으므로:
               1) 라이브러리 서비스를 tools:node="remove" 로 제거하고
               2) 그 서브클래스인 우리 서비스를 MESSAGING_EVENT 로 등록한다.
             우리 서비스는 onMessageReceived 에서 super(=Capacitor 처리)를 항상 호출하므로
             기존 푸시 기능(포그라운드 리스너/일반 알림/토큰 등록)은 그대로 보존된다.
             ════════════════════════════════════════════════════════════════ -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".locationalert.LocationAlertMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

    <!-- [GPS 는 있으면 쓰고 없어도 된다 — 2026-11-20]
         (그 플러그인은 1.3.0(17)에서 뺐다 — 아래 위치 권한 절. 다시 넣을 때를 대비해 이 선언은 남긴다.)
         백그라운드 위치 플러그인(@capacitor-community/background-geolocation)의 매니페스트가
         <uses-feature android:name="android.hardware.location.gps" /> 를 끼워 넣는다(required 기본값 = true).
         그대로 두면 Play 가 GPS 없는 기기(와이파이 전용 태블릿·크롬북·TV)를 지원 대상에서 뺀다 —
         1.3.0(15)을 내부 테스트에 올렸을 때 실제로 나온 경고: 전화 -223 · 태블릿 -2,365(-35%) · 크롬북 -77(-100%),
         이유 「필요한 기능을 지원하지 않습니다(시스템 기능)」. 그 기기의 기존 사용자는 업데이트를 못 받는다.
         required 는 병합할 때 "하나라도 true 면 true" 라서 tools:replace 로 덮어써야 한다.
         GPS 가 없어도 안전한가: 플러그인은 FusedLocationProvider 를 쓰고, 우리 코드(LocationAlertLocator)는
         provider 마다 isProviderEnabled·try/catch 를 거쳐 NETWORK 로 넘어간다. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false"
        tools:replace="android:required" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- [백그라운드 위치·위치 전경 서비스 권한을 뺐다 — 2026-11-20, 사용자 지시 「위치기반 빼자.(2개 기능)」]
         Play 가 정식 출시 전에 두 권한의 신고서(「포그라운드 서비스 권한」·「위치 정보 액세스 권한」)를 요구했다.
         둘 다 「위치 기반 기상 정보 제공」(앱이 꺼져 있을 때 위치 확인) 하나 때문인데, 이 기능은 지금 관리자에게만 보여
         검토자가 기능을 볼 수 없다 → 거절되면 헤드업·앱 안 업데이트가 든 업데이트 전체가 막힌다.
         - 빼는 것: ACCESS_BACKGROUND_LOCATION · FOREGROUND_SERVICE_LOCATION · FOREGROUND_SERVICE,
           그리고 @capacitor-community/background-geolocation 플러그인(package.json). 화면 코드는 이 플러그인을
           이미 쓰지 않았다(이벤트 기반 전환 — js/location-alert/location_alert_background.js 머리말).
         - 혹시 다른 라이브러리가 끼워 넣어도 최종 앱에 남지 않게 tools:node="remove" 로 지운다.
           빌드 절차(build-apk.yml·build-release-aab.yml)도 병합 매니페스트에 남아 있으면 실패시킨다.
         - 영향: 이 버전에서는 앱이 꺼져 있을 때 위치 기반 특보 경보가 위치를 못 얻는다(관리자 전용 기능이라
           일반 사용자 영향 없음). 켜려고 하면 LocationPermPlugin.requestBackground 가 Capacitor 에서
           "Missing the following permissions" 로 거절되고, 화면은 그것을 잡아 앱 정보 화면으로 넘긴다(location_alert_ui.js).
         - 일반 공개할 때 권한·플러그인을 되살리고 Play 신고서(설명·시연 영상·검토자 접근)를 함께 낸다. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- [음성 비서 삭제 2026-11-19, 사용자 지시] 마이크(RECORD_AUDIO)·마이크 전경 서비스(FOREGROUND_SERVICE_MICROPHONE)·
         음성 모델 내려받기 전경 서비스(FOREGROUND_SERVICE_DATA_SYNC) 권한과 그 서비스 2개를 지웠다.
         (FOREGROUND_SERVICE 는 2026-11-20 위 절에서 함께 뺐다 — 전경 서비스를 쓰는 곳이 더는 없다.) -->
    <!-- 네트워크 상태 확인 — MainActivity 의 오프라인 판정(ConnectivityManager)이 쓴다 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
