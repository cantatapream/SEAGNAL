{
  "appId": "com.seagnal.app",
  "appName": "SEA:GNAL(바다날씨)",
  "webDir": "www",
  "server": {
    "url": "https://seagnal-server.fly.dev",
    "cleartext": true,
    "androidScheme": "https"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}