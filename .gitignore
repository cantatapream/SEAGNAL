# 의존성 및 무거운 폴더 제외
node_modules/
backups/
.gemini/
.agent/
.claude/*
!.claude/skills/
!.claude/memory/

# 환경 변수 (비밀번호 등 포함 가능성)
.env

# OS/ID 관련 잡다한 파일들
.DS_Store
Thumbs.db
.vscode/

# 로그 파일
*.log

# 디버그 PDF 데이터
local_server/data/debug_pdf/

# 수심 데이터 (Fly.io Volume에 저장)
local_server/data/bathymetry/

# 관리자 토큰 파일 (Fly.io Volume에 저장, 절대 git 추적 금지)
# 토큰 자체가 인증 자격증명이므로 노출 시 임의 사용자가 admin 접근 가능
local_server/data/admin_tokens.json
local_server/data/admin_tokens.json.tmp

# 태풍 통보문/예보 캐시 (typhoon_crawler.js 가 런타임 생성, Fly.io Volume에 저장)
# 스케줄러가 부팅 시 재생성하므로 추적 제외
local_server/data/typhoon.json
local_server/data/typhoon.json.tmp

# KMA/KHOA 런타임 캐시 (Fly.io Volume에 저장, 스케줄러가 부팅 시 재생성)
local_server/data/marine_buoys.json
local_server/data/marine_forecast.json
local_server/data/marine_lh_buoys.json
local_server/data/marine_vs.json
