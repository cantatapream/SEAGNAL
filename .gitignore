# 사용량/구독 통계 (런타임 누적, Fly.io Volume에 저장)
local_server/data/usage_stats.json
local_server/data/usage_stats.json.migrations.json
local_server/data/subscriber_stats.json

# 5순위: 정적 자원 사전 압축 산출물 (build-gzip.js 가 prestart 에서 생성)
# 원본에서 항상 재생성 가능하므로 추적 제외. uploads/ 디렉토리는 동적 업로드
# 디렉토리라 사전 압축 대상이 아니어서 이 패턴에 걸리지 않는다.
client/**/*.gz
client/**/*.br
local_server/js/**/*.gz
local_server/js/**/*.br
local_server/css/**/*.gz
local_server/css/**/*.br
local_server/tide_data/**/*.gz
local_server/tide_data/**/*.br
local_server/knowledge/graph/topic_embeddings.json
local_server/knowledge/graph/tool_embeddings.json
__pycache__/

# runtime caches generated by server (added 2026-06-04)
local_server/data/buoys.json
local_server/data/general_forecasts.json
local_server/data/regional_forecast.json
local_server/data/tidebed_config.json
local_server/data/weather_alerts.json
local_server/data/zone_forecasts.json
local_server/data/forecast_cache/
local_server/data/khoa_stream_cache.json.gz
local_server/data/tide_usage.json
local_server/data/blocks.json

# wave_leadtime 분석 — 대용량 GIF 캐시/중간산출물은 버전관리 제외
local_server/analysis/wave_leadtime/cache/
local_server/analysis/wave_leadtime/out/
local_server/analysis/wave_leadtime/reports/miss_samples/

# advisory 런타임 예측 산출물 (배치가 생성)
local_server/data/advisory_prediction.json

# 물빠짐 예측 — 앵커 1분 조위곡선 캐시 (tide_field_collector 가 KST 23:30 재생성,
# Fly.io Volume에 저장). 대용량 + 매일 갱신이라 추적 제외.
# grid_meta.json / anchors.json (build_tide_field.js 산출물) 은 추적해 "준비중"
# 상태(빈 메타)라도 명시적으로 커밋 — 운영에서 BADA 로 재생성됨.
local_server/data/tide_field/curves/*.json

# 특보 예측 표출 제어 상태(관리자: 청중 모드 off/admin/all + 구역별 삭제/중지/수정)
local_server/data/advisory_display.json

# 특보 예측 2사이클 지속성 상태(엔진이 매 사이클 생성, Fly 볼륨 보존)
local_server/data/advisory_pending.json
local_server/data/advisory_pending.json.tmp

# 물빠짐 예측 — 서버 사이드 프리컴퓨트 산출물 (precompute_tide_field.js 가 수집
# 직후 재생성, Fly.io Volume에 저장). 전 프레임×전 셀 물깊이 바이너리라 대용량 +
# 매일 갱신이라 추적 제외(런타임 산출물). 라우트는 없으면 cellDepthM 폴백.
local_server/data/tide_field/frames.bin
local_server/data/tide_field/frames.bin.tmp
local_server/data/tide_field/frames_meta.json
local_server/data/tide_field/frames_meta.json.tmp
# 격자 보정(nudge) 캐시 — 수집 중 생성되는 런타임 산출물(볼륨 영속).
local_server/data/tide_field/anchor_probe_override.json
local_server/data/tide_field/anchor_probe_override.json.tmp

# 특보예측 검증 청별 중간 산출물(재생성 가능 — 최종 RECALIB_national.md 만 추적)
local_server/analysis/wave_leadtime/reports/recalib_*.log
local_server/analysis/wave_leadtime/reports/RECALIB_jeju.md
local_server/analysis/wave_leadtime/reports/RECALIB_busn.md
local_server/analysis/wave_leadtime/reports/RECALIB_gwju.md
