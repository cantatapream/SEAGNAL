local_server/analysis/wave_leadtime/out/recalib_samples_*.json

# 예비특보 통보문 수집물(dmdw 크롤링 산출)
local_server/analysis/wave_leadtime/data/prelim_warnings.json

# 특보 예측 운영 누적 저널(분석력 강화용 — Fly 볼륨, append-only)
local_server/data/advisory_journal.jsonl

# dmdw 통보문 수집 원본(분석 산출물은 별도)
local_server/analysis/wave_leadtime/data/bulletins.json
local_server/analysis/wave_leadtime/data/bulletins_*.json

# ── 보안: 서비스 계정 키 (리팩토링 STEP 0, 2026-07-13) ──
# 키 파일은 secrets/ 에 두며 git 에 절대 커밋하지 않는다
secrets/
serviceAccountKey*.json
googla_cloud_api_backup_bot_key/

# 사고정보(선박/인명) 원본 CSV·SHP·코드정의서 xlsx — 국립해양조사원 원본 데이터,
# 용량이 커서(zip 3개 합계 ~70MB) 커밋하지 않는다. build_accidents.js 의 입력이며
# 변환 결과(client/accident_*.json)만 커밋한다. 재생성 시 이 폴더에 CSV를 두고
# node scripts/build_accidents.js 실행.
local_server/scripts/_accident_raw/
