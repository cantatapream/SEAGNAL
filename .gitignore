# 의존성 및 무거운 폴더 제외
node_modules/
backups/
.gemini/
.agent/
.claude/*
!.claude/skills/
!.claude/memory/

# 환경 변수 (비밀번호 등 포함 가능성)
.env

# OS/ID 관련 잡다한 파일들
.DS_Store
Thumbs.db
.vscode/

# 로그 파일
*.log

# 디버그 PDF 데이터
local_server/data/debug_pdf/

# 수심 데이터 (Fly.io Volume에 저장)
local_server/data/bathymetry/

# 제주 BADA 격자 산출물(build_jeju_bathy_grid.js) — 아직 어떤 런타임 코드도 읽지 않는
# 로컬 검증용 스냅샷이라, grid_meta.json/anchors.json 과 달리 빈 placeholder 관례를
# 적용하지 않는다. Task #14 에서 실제 소비자(앵커 재산정)가 생기면 그때 관례를 정한다.
local_server/data/tide_field/grid_meta_jeju.json
local_server/data/tide_field/anchors_jeju.json

# 관리자 토큰 파일 (Fly.io Volume에 저장, 절대 git 추적 금지)
# 토큰 자체가 인증 자격증명이므로 노출 시 임의 사용자가 admin 접근 가능
local_server/data/admin_tokens.json
local_server/data/admin_tokens.json.tmp

# 나리야 답변완료 푸시용 1회용 임시 보관함 (최대 3시간, 조회 즉시 삭제 — 런타임 생성)
# 사용자 질문/답변이 잠깐 들어 있으므로 절대 git 추적 금지
local_server/data/pending_answers.json
local_server/data/pending_answers.json.tmp

# 자식(연안바다/평수구역)-only 통보문 보강 펜딩/매칭 state — 런타임 생성, 재시작 생존용
local_server/data/child_bulletin_state.json
local_server/data/child_bulletin_state.json.tmp

# 나리야 배포 스위치(노출·canonical필터·H-37 3종) — 관리자가 런타임에 켜고 끄는 값이라
# Fly.io Volume 에만 있어야 한다(2026-08-14 H-37 F1: 종전엔 이미지 안 경로라 재시작마다 리셋됐다).
# 이미지에 같은 경로 파일을 넣어도 볼륨 마운트에 가려지므로 추적하지 않는다.
local_server/data/nariya_config.json
local_server/data/nariya_config.json.tmp

# 태풍 통보문/예보 캐시 (typhoon_crawler.js 가 런타임 생성, Fly.io Volume에 저장)
# 스케줄러가 부팅 시 재생성하므로 추적 제외
local_server/data/typhoon.json
local_server/data/typhoon.json.tmp

