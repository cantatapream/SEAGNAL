# =============================================================================
# .env.example — 운영 환경변수 예시 (이 파일은 git 추적됨)
# =============================================================================
# 실제 .env 파일은 .gitignore 에 의해 추적되지 않습니다.
# 로컬 개발 시: 이 파일을 .env 로 복사하고 실제 값으로 채워 사용.
# Fly.io 배포 시: `fly secrets set KEY=VALUE` 로 등록 (서버에 .env 안 올라감).
# =============================================================================

# ----------------------------------------------------------------------------
# [필수] 관리자 비밀번호 (Phase 4-A 보안 강화)
# ----------------------------------------------------------------------------
# 이 값과 일치하는 비밀번호로 로그인해야 admin 페이지 + 점검 우회 사용 가능.
# 클라이언트 코드에는 절대 노출되지 않으며, 오직 서버 측에서만 검증.
#
# !!! 중요 !!!
#   - 아래 값은 자리 표시자일 뿐, 실제 운영 비밀번호가 아닙니다.
#   - 절대 이 파일에 실제 비밀번호를 적지 마세요 (git 추적됨, 영구 노출 위험).
#   - 로컬 개발 시: 이 파일을 .env 로 복사 후 .env 안에서만 실제 값으로 교체.
#                  (.env 는 .gitignore 에 의해 추적되지 않음)
#   - Fly.io 배포: `fly secrets set ADMIN_PASSWORD=<실제값>` 으로 등록.
#
# 미설정 시: 모든 admin 로그인 실패 (의도된 동작, 보안 회귀 방지).
ADMIN_PASSWORD=changeme-replace-with-your-strong-password

# ----------------------------------------------------------------------------
# [선택] 외부 API 키 (이미 코드에 사용 중)
# ----------------------------------------------------------------------------
# KAKAO_REST_API_KEY=...
# GEMINI_API_KEY=...
# GEMINI_API_KEY_2=...
# ROMS_SERVICE_KEY=...
# NAVER_CLIENT_ID=...       (NAVER API HUB — 백과사전/지식iN/블로그/오타변환, console.ncloud.com 발급)
# NAVER_CLIENT_SECRET=...
